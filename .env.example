# Set DEMO_MODE=true to browse the hub with sample data (no ESPN cookies needed).
DEMO_MODE=true

# ESPN private league (required when DEMO_MODE=false)
LEAGUE_ID=374834
YEAR=2026
SWID={YOUR-SWID-UUID}
ESPN_S2=your_espn_s2_cookie_value

# Optional shared password so a public URL is not fully open.
# Leave blank to disable the login gate (local development).
HUB_PASSWORD=

# Cache ESPN payloads to stay polite on game day (seconds)
CACHE_TTL_SECONDS=180

# History / playoffs
HISTORY_START_YEAR=2016
PLAYOFF_TEAMS=6
